# ai-receptionist configuration
# Copy to `.env` and fill in. Never commit `.env`.

# ─── Who this answers for ────────────────────────────────────────
# Filled into the prompts at load time, so `prompts/` ships with placeholders
# rather than a name edited into it. See SETUP.md for the full placeholder list.
OWNER_NAME=
# they/them by default. Only object and possessive forms are used, because those
# read correctly for every pronoun set without changing the verb around them.
OWNER_PRONOUN_OBJECT=them
OWNER_PRONOUN_POSSESSIVE=their
# Defaults to "<OWNER_NAME>'s assistant".
ASSISTANT_NAME=
# How the agent should sound. Defaults to British English, including reading
# "oh" for zero and "zed" for Z. REPLACE THIS if you are not in the UK.
LOCALE_NOTE=

# ─── Setting this up ─────────────────────────────────────────────
# Most of this file can be filled in from the admin UI instead:
# http://127.0.0.1:5051/setup walks it in five steps, reads the available
# voices / models / phone numbers live from your accounts, and checks each
# credential before storing it. What it writes goes to config/secrets.json
# (gitignored, 0600) and wins over the values here.
#
# These stay .env-only on purpose, because they change the security posture
# rather than a destination — a stolen admin session must not be able to touch
# them: ADMIN_PASSWORD, VALIDATE_TWILIO_SIGNATURE, TRANSFER_ENABLED,
# TRANSFER_TO_NUMBER, CALLBACKS_ENABLED, RETAIN_TRANSCRIPTS, PUBLIC_BASE_URL.

# ─── Voice provider ──────────────────────────────────────────────
# Which service actually answers the phone: openai | elevenlabs
#
# Everything downstream is identical either way - the same tools, the same call
# record, the same supervisor, notifications, callbacks and transfers. This is a
# swap of the voice, the turn-taking and the billing, not of what the
# receptionist does. Fill in the matching section below; the other can stay
# blank.
VOICE_PROVIDER=openai

# ─── OpenAI (VOICE_PROVIDER=openai) ──────────────────────────────
# Needs Realtime API access. Verify with:
#   curl -s -H "Authorization: Bearer $KEY" https://api.openai.com/v1/models | grep realtime
OPENAI_API_KEY=
# gpt-realtime-mini is the cheap default; gpt-realtime for quality comparison.
OPENAI_REALTIME_MODEL=gpt-realtime-mini
# alloy ash ballad coral echo sage shimmer verse marin cedar
OPENAI_VOICE=marin

# ─── ElevenLabs (VOICE_PROVIDER=elevenlabs) ──────────────────────
# An ElevenLabs agent is a persistent object that already carries its tools,
# turn-taking and LLM, so it has to be provisioned before the first call:
#
#   python scripts/elevenlabs_setup.py --dry-run   # see what it will send
#   python scripts/elevenlabs_setup.py             # create it, print the id
#
# Or press "Create the agent" in the setup wizard, which runs the same code.
#
# Do NOT hand-build the agent in the dashboard unless you are willing to set
# ulaw_8000 audio both ways, five client tools, and the override allowlist by
# hand - all three fail silently when wrong. See SETUP.md.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Both optional. Blank means "whatever the agent itself is set to", which is the
# right default - the agent is the source of truth for its own voice.
ELEVENLABS_VOICE_ID=
ELEVENLABS_LANGUAGE=

# ─── Twilio ──────────────────────────────────────────────────────
# The AUTH TOKEN (not the API key secret) is what signs inbound webhooks.
# Console → Account → API keys & tokens → Auth Token.
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=
# Set false ONLY for local curl testing. Never false on a public endpoint.
VALIDATE_TWILIO_SIGNATURE=true

# ─── Service ─────────────────────────────────────────────────────
PORT=5050
# Public origin Twilio dials. Also used to rebuild the exact URL Twilio signed,
# so it must match the webhook URL character for character.
PUBLIC_BASE_URL=https://
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# Secret used to bind a media WebSocket to the call that created it.
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
STREAM_TOKEN_SECRET=
STREAM_TOKEN_TTL_S=120

# ─── Supervisor (optional) ───────────────────────────────────────
# Writes the call summary after the caller has hung up. ANY endpoint that
# speaks the OpenAI chat-completions API will do - the URL is the origin, and
# /v1/chat/completions is appended. See "The supervisor" in the README for the
# response contract and worked examples.
#
# Leave SUPERVISOR_ENABLED=false and the service composes summaries locally
# with no network call. That is a supported way to run it, not a degraded one.
SUPERVISOR_ENABLED=false
SUPERVISOR_URL=
SUPERVISOR_KEY=
SUPERVISOR_MODEL=gpt-4o-mini

# Examples - pick one, delete the rest:
#   OpenAI          SUPERVISOR_URL=https://api.openai.com
#                   SUPERVISOR_KEY=sk-...            MODEL=gpt-4o-mini
#   Local Ollama    SUPERVISOR_URL=http://host.docker.internal:11434
#                   SUPERVISOR_KEY=                  MODEL=qwen2.5:14b
#   OpenRouter      SUPERVISOR_URL=https://openrouter.ai/api
#                   SUPERVISOR_KEY=sk-or-...         MODEL=anthropic/claude-sonnet-4
#   An agent        SUPERVISOR_URL=http://host.docker.internal:8645
#   with notes      SUPERVISOR_KEY=<its bearer key>  MODEL=<its model name>
#
# HERMES_SUPERVISOR_URL / _KEY / _MODEL are still honoured for existing
# installs; the names above win when both are set.

# Turning a reply into a spoken callback script. Nobody is on the line for it.
SUPERVISOR_SCRIPT_TIMEOUT_S=24
# Composing the summary. Generous on purpose: the caller has already hung up,
# and an agent that searches your notes first needs the room.
SUPERVISOR_FINAL_TIMEOUT_S=150

# ─── Notification ────────────────────────────────────────────────
# Any number of channels can be on at once. Everything here is a DEFAULT:
# once the admin UI has saved a channel, config/settings.json wins for the
# non-secret fields. Secrets are marked and are only ever read from here.
#
# A routing table in the UI decides which channels each call category reaches,
# so spam can go nowhere while an urgent call goes everywhere. With no routing
# configured, every enabled channel gets everything.

# --- Telegram ---
# A bot dedicated to the receptionist (BotFather), NOT one shared with another
# agent - two pollers on one token collide. This is the only channel that can
# trigger a callback, because it is the only one with both a reliable
# message-to-call correlation and a sender identity that is hard to forge.
# secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email ---
# Plain SMTP via the standard library; no extra dependency. Port 465 is
# implicit TLS, 587 and 25 use STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# secret
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_STARTTLS=true
EMAIL_TO=

# --- Webhook ---
# Receives the summary text plus the structured call record as JSON. Covers
# ntfy, Gotify, Discord, Home Assistant, n8n and anything else.
WEBHOOK_URL=
# Optional, "Header-Name: value" e.g. "Authorization: Bearer abc123".
# secret
WEBHOOK_AUTH_HEADER=

# --- WhatsApp ---
# Via a self-hosted bridge (WAHA, Evolution API, or anything similar), paired
# by scanning a QR from Settings → WhatsApp → Pair a number.
#
# PAIR A DEDICATED NUMBER. The bridge signs in as a real WhatsApp account and
# can message anyone that account can reach; pointing it at your personal
# account makes this container's worst case "can impersonate you to all your
# contacts". See src/whatsapp.py for why the official API is not an option.
WHATSAPP_BRIDGE_URL=
# secret
WHATSAPP_BRIDGE_KEY=
# waha | evolution | custom
WHATSAPP_FLAVOUR=waha
WHATSAPP_SESSION=default
WHATSAPP_TO=

# ─── Call guards ─────────────────────────────────────────────────
MAX_CALL_SECONDS=300
SILENCE_HANGUP_SECONDS=25

# ─── Data retention ──────────────────────────────────────────────
# Off by default by design. Turning this on starts keeping caller speech
# transcripts on disk - a policy decision, not a config tweak.
RETAIN_TRANSCRIPTS=false
# How readily it decides you have finished speaking: low | auto | high
VAD_EAGERNESS=auto

# Spoken verbatim at answer. Keep it short and identify the assistant.
GREETING=

# --- Caller recognition ------------------------------------------
# JSON map of number -> name. Recognised callers are greeted warmly and not
# asked for details we already have. It does NOT relax what may be disclosed:
# caller ID is spoofable.
CONTACTS_PATH=/app/config/contacts.json
CONTACTS_COUNTRY_CODE=44

# --- Callbacks ---------------------------------------------------
# Replying to a call summary in Telegram rings that caller back with your
# message. Off by default: it spends money and disturbs a real person.
CALLBACKS_ENABLED=false
# REQUIRED when callbacks are on. Comma-separated Telegram user ids permitted
# to trigger a call. Chat id alone is not sufficient - if the chat ever becomes
# a group, every member could otherwise dial out.
TELEGRAM_ALLOWED_USER_IDS=
CALLBACK_COOLDOWN_S=300
CALLBACK_MAX_PER_HOUR=6

# --- Transfer ----------------------------------------------------
# Let the receptionist put a screened caller through. Off by default; when off
# the agent is not given the tool at all, so it cannot be talked into using it.
TRANSFER_ENABLED=false
TRANSFER_TO_NUMBER=
TRANSFER_TIMEOUT_S=20

# --- Loop breaking -----------------------------------------------
# If a call reaches either threshold with no message recorded, the service
# nudges the agent to take what it has and close politely.
WRAP_UP_AFTER_S=120
WRAP_UP_AFTER_TURNS=8

# --- Admin UI ---------------------------------------------------------------
# Contacts, call history, and the notification settings page. Served on
# ADMIN_PORT and published to 127.0.0.1 only. Reach it remotely over Tailscale;
# never proxy it publicly. Empty password disables the UI entirely.
ADMIN_PASSWORD=
ADMIN_PORT=5051
# Leave as 0.0.0.0 in Docker - the compose publish (127.0.0.1:5051:5051) is the
# boundary, and binding loopback inside a container makes the published port
# unreachable rather than safer. Set 127.0.0.1 when running WITHOUT a container.
ADMIN_BIND=0.0.0.0

# Written by the admin UI: which channels are on, where each call category
# goes, and how the agent handles a call. Optional - with no file, every value
# falls back to the environment and the service behaves exactly as it does now.
# Secrets are never written here.
SETTINGS_PATH=/app/config/settings.json

# --- Caller history ---------------------------------------------------------
HISTORY_ENABLED=true
HISTORY_MAX_CALLS=3
